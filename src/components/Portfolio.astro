---
import { Image } from 'astro:assets';
import MediaGrid, { type MediaEntry } from './MediaGrid.astro';
import { type CompanyLogo, type Copy, type MediaItem, type MediaKey, companies, email, social, toolbox } from '../content';
import cesarCto from '../assets/cesar-cto.jpg';
import cesarAvatar from '../assets/cesar-avatar.jpg';
import cesarNormal from '../assets/cesar-normal.jpg';
import cesarComica from '../assets/cesar-comica.jpg';
import tridiProceso from '../assets/tridi-proceso.jpg';
import casitaAzul from '../assets/clients/casita-azul.jpg';
import laColmenita from '../assets/clients/la-colmenita.jpg';
import semillitas from '../assets/clients/semillitas.jpg';
import admiraltyTubes from '../assets/clients/admiralty-tubes.jpg';
import mobra from '../assets/clients/mobra.jpg';
import chelyCleaning from '../assets/clients/chely-cleaning.jpg';
import tripealoWeb from '../assets/tripealo-web.png';
import drpantallaWeb from '../assets/drpantalla-web.webp';
import drpantallaSistema from '../assets/drpantalla-sistema.png';
import kungfu from '../assets/kungfu-cover.png';
import ph26 from '../assets/ph26.png';
import stripTripealo from '../assets/strip/tripealo-mobile.jpeg';
import stripTripealoMerch from '../assets/strip/tripealo-merch.jpeg';
import stripTridi from '../assets/strip/tridi-presentacion.webp';
import stripDrpantalla from '../assets/strip/drpantalla-mobile.jpeg';
import logoTripealo from '../assets/logos/tripealo.png';
import logoDrpantalla from '../assets/logos/drpantalla.png';
import logoKiwi from '../assets/logos/kiwi.png';
import logoEstela from '../assets/logos/estela.png';

interface Props {
  t: Copy;
}

const { t } = Astro.props;
const mediaAssets: Record<MediaKey, Omit<MediaEntry, 'alt'>> = {
  tripealo: { src: tripealoWeb },
  drpantalla: { src: drpantallaWeb },
  // Screenshot trimmed of its empty right margin (~1.89:1), shown whole with `contain`
  'drpantalla-sistema': { src: drpantallaSistema, position: 'center', fit: 'contain' },
  tridi: { src: tridiProceso, position: '50% 55%' },
  ph26: { src: ph26, position: 'center', fit: 'contain' },
  kungfu: { src: kungfu, position: 'center' },
};
const companyLogos: Record<CompanyLogo, ImageMetadata> = {
  tripealo: logoTripealo,
  drpantalla: logoDrpantalla,
  kiwi: logoKiwi,
  estela: logoEstela,
};
const toEntry = (item: MediaItem, alt: string): MediaEntry =>
  typeof item === 'string'
    ? { ...mediaAssets[item], alt }
    : { ...mediaAssets[item.poster], video: item.video, alt };
const clientImages = {
  'casita-azul': casitaAzul,
  'la-colmenita': laColmenita,
  semillitas,
  'admiralty-tubes': admiraltyTubes,
  mobra,
  'chely-cleaning': chelyCleaning,
};
// Fanned strip under the hero.
// Order: Tripealo + photo on the left, Tridi in the middle,
// photo + Doctor Pantalla on the right. `hover` swaps in another image on hover,
// `position` / `hoverPosition` are the object-position used to frame each image in the 4:5 card.
const strip: { src: ImageMetadata; hover?: ImageMetadata; position?: string; hoverPosition?: string }[] = [
  { src: stripTripealo, hover: stripTripealoMerch, position: '50% 0%' },
  { src: cesarCto, position: '50% 15%' },
  { src: stripTridi, hover: tridiProceso, position: '100% 50%', hoverPosition: '50% 50%' },
  { src: cesarNormal, hover: cesarComica, position: '50% 30%' },
  { src: stripDrpantalla, position: '50% 0%' },
];
const year = new Date().getFullYear();
---

<div class="page">
  <div class="shell">
    <header class="topbar">
      <!-- Empty slot where the logo was: keeps the nav centered and the bar from shifting -->
      <span class="topbar-slot" aria-hidden="true"></span>
      <nav class="nav" aria-label="Principal">
        <a href="#inicio">{t.nav.home}</a>
        <a href="#sobre-mi">{t.nav.about}</a>
        <a href="#experiencia">{t.nav.experience}</a>
        <a href="#proyectos">{t.nav.projects}</a>
        <a href="#contacto">{t.nav.contact}</a>
      </nav>
      <div class="socials">
        <a href={social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.06c.53-1 1.83-1.8 3.76-1.8 4.02 0 4.76 2.64 4.76 6.08v5.22h-4v-4.63c0-1.1-.02-2.52-1.54-2.52-1.54 0-1.78 1.2-1.78 2.44v4.71h-4v-11Z" /></svg>
        </a>
        <a href={social.github} target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
        </a>
        <a href={`mailto:${email}`} aria-label="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
        </a>
        <a class="lang" href={t.nav.otherLangHref} hreflang={t.nav.otherLang.toLowerCase()}>{t.nav.otherLang}</a>
      </div>
    </header>

    <main>
      <section id="inicio" class="hero">
        <div class="avatar" data-enter style="--d: 0ms">
          <Image src={cesarAvatar} alt={t.hero.photoAlt} width={320} loading="eager" />
        </div>
        <div class="rule"></div>
        <p class="hello">{t.hero.greeting}</p>
        <h1>
          {t.hero.title.map((line, i) => (
            <span class="line"><span style={`--i: ${i}`}>{line}</span></span>
          ))}
        </h1>
        <div class="rule"></div>
        <p class="subtitle" data-enter style="--d: 420ms">{t.hero.subtitle}</p>
        <div class="hero-actions" data-enter style="--d: 500ms">
          <a class="btn" href={t.cv.href} download={t.cv.filename}>
            {t.cv.label}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" /></svg>
          </a>
          <a class="btn ghost" href={`mailto:${email}`}>{t.about.contactCta} →</a>
        </div>
        <div class="rule"></div>
        <div class="strip" aria-hidden="true">
          {
            strip.map((s, i) => {
              const style = `--d: ${560 + i * 70}ms; --pos: ${s.position ?? '50% 50%'}; --pos-hover: ${s.hoverPosition ?? s.position ?? '50% 50%'}`;
              return s.hover ? (
                <div class="strip-swap" data-enter style={style}>
                  <Image src={s.src} alt="" width={460} />
                  <Image class="photo-funny" src={s.hover} alt="" width={460} />
                </div>
              ) : (
                <Image src={s.src} alt="" width={460} data-enter style={style} />
              );
            })
          }
        </div>
      </section>

      <section id="sobre-mi" class="section">
        <div class="section-head" data-reveal>
          <p class="label">{t.about.label}</p>
          <h2>{t.about.title}</h2>
        </div>
        <div class="bento">
          <article class="card intro" data-reveal>
            <div>
              <h3>{t.about.introTitle}</h3>
              <p>{t.about.intro}</p>
            </div>
            <div class="intro-photo">
              <Image class="photo-normal" src={cesarNormal} alt={t.hero.photoAlt} width={420} />
              <Image class="photo-funny" src={cesarComica} alt="" width={420} aria-hidden="true" />
            </div>
          </article>

          <article class="card strengths" data-reveal style="--d: 80ms">
            {
              t.about.strengths.map((s) => (
                <div class="strength">
                  <p class="tag">{s.label}</p>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              ))
            }
          </article>

          <article class="card toolbox" data-reveal style="--d: 160ms">
            <h3>{t.about.toolboxTitle}</h3>
            <p>{t.about.toolboxText}</p>
            <ul>{toolbox.map((tool) => <li>{tool}</li>)}</ul>
          </article>

          <article class="card talk" data-reveal style="--d: 240ms">
            <div>
              <h3>{t.about.contactTitle}</h3>
              <p>{t.about.contactText}</p>
            </div>
            <a class="btn" href={`mailto:${email}`}>{t.about.contactCta} →</a>
          </article>
        </div>
      </section>

      <section id="experiencia" class="section">
        <div class="section-head" data-reveal>
          <p class="label">{t.experience.label}</p>
          <h2>{t.experience.title}</h2>
        </div>
        <ol class="jobs">
          {
            t.experience.jobs.map((j, i) => {
              const { logo, link } = companies[j.company] ?? {};
              return (
              <li class="job" data-reveal style={`--d: ${i * 70}ms`}>
                <span class="job-logo" aria-hidden="true">
                  {logo ? <Image src={companyLogos[logo]} alt="" width={96} /> : j.company.charAt(0)}
                </span>
                <div class="job-main">
                  <div class="job-head">
                    <h3>
                      {j.role}{' '}
                      <span>
                        ·{' '}
                        {link ? (
                          <a href={link} target="_blank" rel="noopener">
                            {j.company} <span aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          j.company
                        )}
                      </span>
                    </h3>
                    <p class="job-dates">{j.dates}</p>
                  </div>
                  <p class="job-place">{j.place}</p>
                  <p>{j.text}</p>
                </div>
              </li>
              );
            })
          }
        </ol>
      </section>

      <section id="proyectos" class="section">
        <div class="section-head" data-reveal>
          <p class="label">{t.projects.label}</p>
          <h2>{t.projects.title}</h2>
        </div>
        <div class="projects">
          {
            t.projects.items.map((p, i) => (
              <article class="card project" data-reveal style={`--d: ${(i % 2) * 90}ms`}>
                <div class="project-img">
                  <MediaGrid cells={p.media.map((cell) => cell.map((item) => toEntry(item, p.name)))} />
                  {p.play && (
                    <a class="project-play" href={p.play.href}>
                      <span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
                        {p.play.label}
                      </span>
                    </a>
                  )}
                </div>
                <div class="project-body">
                  <p class="tag">{p.tag}</p>
                  <h3>{p.name}</h3>
                  <p>{p.text}</p>
                  {p.link && (
                    <a href={p.link.href} target="_blank" rel="noopener">
                      {p.link.label} ↗
                    </a>
                  )}
                  {p.play && <a href={p.play.href}>{p.play.label} →</a>}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="clientes" class="section">
        <div class="section-head" data-reveal>
          <p class="label">{t.clients.label}</p>
          <h2>{t.clients.title}</h2>
        </div>
        <p class="subtitle section-intro">{t.clients.intro}</p>
        <div class="clients">
          {
            t.clients.items.map((c, i) => {
              const Tag = c.link ? 'a' : 'article';
              return (
                <Tag class="card client" data-reveal style={`--d: ${(i % 3) * 80}ms`} {...(c.link ? { href: c.link, target: '_blank', rel: 'noopener' } : {})}>
                  <div class="client-img">
                    <Image src={clientImages[c.image]} alt={c.name} width={640} />
                  </div>
                  <div class="client-body">
                    <p class="tag">{c.tag}</p>
                    <h3>
                      {c.name} {c.link && <span aria-hidden="true">↗</span>}
                    </h3>
                    <p>{c.text}</p>
                  </div>
                </Tag>
              );
            })
          }
        </div>

        <h3 class="private-title" data-reveal>{t.clients.privateTitle}</h3>
        {
          t.clients.privateCases.map((pc, i) => (
            <article class={`card private-case variant-${i}`} data-reveal>
              <div class="private-visual" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span>
              </div>
              <div class="private-body">
                <p class="tag">{pc.tag}</p>
                <h3>{pc.title}</h3>
                <p>{pc.text}</p>
                <ul>{pc.points.map((pt) => <li>{pt}</li>)}</ul>
                <p class="note">{pc.note}</p>
              </div>
            </article>
          ))
        }

        <div class="education" data-reveal>
          <p class="label">{t.education.label}</p>
          <ul>
            {
              t.education.items.map((e) => (
                <li>
                  <strong>{e.school}</strong>
                  <span>
                    {e.degree} · {e.dates}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="contacto" class="section contact">
        <div class="section-head" data-reveal>
          <p class="label">{t.contact.label}</p>
          <h2>{t.contact.title}</h2>
        </div>
        <p class="subtitle" data-reveal style="--d: 80ms">{t.contact.text}</p>
        <div class="contact-actions" data-reveal style="--d: 160ms">
          <a class="btn" href={`mailto:${email}`}>{email}</a>
          <a class="btn ghost" href={t.cv.href} download={t.cv.filename}>{t.cv.label} ↓</a>
          <a class="btn ghost" href={social.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a class="btn ghost" href={social.github} target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>{t.footer} · {year}</p>
    </footer>
  </div>
</div>
